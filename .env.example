# ==============================================================================
# NLECloud IoT Credentials (Required for project provisioning & API access)
# The SDK uses these credentials to log in, obtain an AccessToken, and execute requests.
# ==============================================================================
NLE_ACCOUNT="your_nlecloud_account"
NLE_PASSWORD="your_nlecloud_password"

# Optional: NLECloud API base URL (defaults to http://api.nlecloud.com if omitted)
NLE_BASE_URL="http://api.nlecloud.com"

# ==============================================================================
# Project Configuration
# ==============================================================================
# Name of the project to provision or delete (defaults to smart-home-dock)
PROJECT_NAME="smart-home-dock"

# Optional: Custom namespace prefix for devices (defaults to p<project_id>, e.g. p1476967)
# Must contain only alphanumeric characters or underscores
# DEVICE_NAMESPACE="my_dock"

# ==============================================================================
# Backend Server Configuration (Optional)
# ==============================================================================
HOST="0.0.0.0"
PORT=3000

# ==============================================================================
# Frontend Configuration (Used by Vite)
# ==============================================================================
VITE_BACKEND_URL="http://localhost:3000"
