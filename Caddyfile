{
    auto_https disable_redirects
}

(proxy_rules) {
    # API backend
    handle /api* {
        reverse_proxy server:3000
    }

    # Backend SSE EventSource routes
    handle /events* {
        reverse_proxy server:3000
    }

    # Frontend upstream (defaults to production static-web-server on :8787, or :5173 in debug mode)
    handle {
        reverse_proxy {$FRONTEND_UPSTREAM:frontend:8787}
    }
}

# HTTP listener
http://localhost:8080, http://:8080 {
    import proxy_rules
}

# HTTPS listener with local self-signed certificate
https://localhost:8443, https://:8443 {
    tls internal
    import proxy_rules
}
